  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe3c7bd4172c8f045ab467a8425b9947, type: 3}
  m_Name: Mover
  m_EditorClassIdentifier: 
  dialogueLines:
  - lineText: Dude your head is on fire are you okay!
    speakerName: Thabo
  - lineText: Yes I am fine do not worry about this more importantly who are you?
    speakerName: Kenith
  - lineText: Hi I am Thabo, I am lost, the man outside said I can stay the night
    speakerName: Thabo
  - lineText: Oh another one I see, I swear we did this with Lebo. (I need talk to
      Mpho about this)
    speakerName: Man
  - lineText: Lebo? Who is that is it the man I saw in the front.
    speakerName: Thabo
  - lineText: 'Oh do not worry about that just make sure you leave first thing in
      the morning. '
    speakerName: Man
  - lineText: No problem, I want to get home as soon as possible I got plans for
      tommorow.
    speakerName: Thabo
  - lineText: 'I am Kenith by the way I situate people here almost like a receptionist. '
    speakerName: Kenith
  - lineText: We currently have people in all the rooms here but I will put you with
      Trevor. He does not mind guests
    speakerName: Kenith
  - lineText: Thank you again I will be more careful when exploring from now on.
    speakerName: Thabo
  - lineText: Please do not disturb our other residents while you here, go to the
      right and the room is at the bottom of the
    speakerName: Kenith
  - lineText: hallway. (Why does James keep letting people in like this)
    speakerName: Kenith
