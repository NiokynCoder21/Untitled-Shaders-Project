  m_Script: {fileID: 11500000, guid: fe3c7bd4172c8f045ab467a8425b9947, type: 3}
  m_Name: Stayer
  m_EditorClassIdentifier: 
  dialogueLines:
  - lineText: Oh my gosh what was that all about?
    speakerName: Thabo
  - lineText: Mhmm, who are you ? We do not need anymore trouble.
    speakerName: Man
  - lineText: I am Thabo, I am lost I came here cause I saw the flame.
    speakerName: Thabo
  - lineText: Lost I see well, it is dark out so go talk to Kenith. You seem harmless
      enough he should help you.
    speakerName: Man
  - lineText: Thank you I promise I will not be any trouble. (I wonder who that person
      was)
    speakerName: Thabo
  - lineText: Do not get to comfortable through, this is not some hotel even though
      it looks like one.
    speakerName: Man
